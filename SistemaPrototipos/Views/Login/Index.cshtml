@model SistemaPrototipos.Models.LoginModel
@{
    ViewData["Title"] = "Iniciar sesión";
    ViewData["BodyClass"] = "login-page";
    Layout = "_LayoutLogin";
}

<main class="login-box">
    <h1 class="login-logo">
        <a asp-controller="Login" asp-action="Index"><b>Sistema</b>Prototipos</a>
    </h1>
    <div class="card card-outline card-primary">
        <div class="card-body login-card-body">
            <p class="login-box-msg">Inicie sesión para continuar</p>

            @if (TempData["Mensaje"] != null)
            {
                <div class="alert alert-success py-2">@TempData["Mensaje"]</div>
            }

            <form asp-controller="Login" asp-action="Index" method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

                <label class="visually-hidden" asp-for="Correo">Correo electrónico</label>
                <div class="input-group">
                    <input asp-for="Correo" type="email" class="form-control" placeholder="Correo electrónico" autocomplete="username" />
                    <div class="input-group-text">
                        <span class="bi bi-envelope"></span>
                    </div>
                </div>
                <span asp-validation-for="Correo" class="text-danger small d-block mb-3"></span>

                <label class="visually-hidden" asp-for="Contrasena">Contraseña</label>
                <div class="input-group">
                    <input asp-for="Contrasena" class="form-control" placeholder="Contraseña" autocomplete="current-password" />
                    <div class="input-group-text">
                        <span class="bi bi-lock-fill"></span>
                    </div>
                </div>
                <span asp-validation-for="Contrasena" class="text-danger small d-block mb-3"></span>

                <div class="row">
                    <div class="col-7">
                        <div class="form-check">
                            <input asp-for="Recordarme" class="form-check-input" />
                            <label asp-for="Recordarme" class="form-check-label">Recordarme</label>
                        </div>
                    </div>
                    <div class="col-5">
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary">Ingresar</button>
                        </div>
                    </div>
                </div>
            </form>

            <hr />

            <p class="mb-1">
                <a asp-controller="Login" asp-action="RecuperarContrasena">Olvidé mi contraseña</a>
            </p>
            <p class="mb-0">
                <a asp-controller="Login" asp-action="Registro" class="text-center">Registrar una cuenta nueva</a>
            </p>
        </div>
    </div>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
