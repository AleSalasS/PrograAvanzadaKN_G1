@model Tarea1.Models.RestablecerContrasenaModel

@{
    Layout = null;
}

<!doctype html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Restablecer contraseña | Bioquimia</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <link rel="stylesheet" href="~/assets/css/adminlte.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" />
</head>

<body class="login-page bg-body-secondary">

    <main class="login-box">

        <div class="login-logo">
            <img src="~/assets/img/logoBioquimiaAlt.png"
                 alt="Logo Bioquimia"
                 style="max-width: 320px; height: auto;" />

            <p class="mt-2 mb-0 text-secondary">
                Sistema de prototipos
            </p>
        </div>

        <div class="card card-outline card-primary">

            <div class="card-body login-card-body">

                <p class="login-box-msg">
                    Establecer nueva contraseña
                </p>

                @if (ViewBag.TokenInvalido == true)
                {
                    <div class="alert alert-danger">

                        <h6>
                            <i class="bi bi-exclamation-triangle"></i>
                            Enlace inválido o vencido
                        </h6>

                        <p class="small mb-2">
                            El enlace de recuperación no es válido,
                            ya venció o ya fue utilizado.
                        </p>

                        <a href="@Url.Action(
                            "RecuperarContrasena",
                            "Login")"
                           class="btn btn-primary btn-sm">

                            Solicitar un nuevo enlace

                        </a>

                    </div>
                }
                else
                {
                    <p class="text-muted small">
                        Ingrese su nueva contraseña y confírmela
                        para recuperar el acceso a su cuenta.
                    </p>

                    using (Html.BeginForm(
                        "RestablecerContrasena",
                        "Login",
                        FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()

                        @Html.ValidationSummary(
                            true,
                            "",
                            new { @class = "text-danger small mb-2" }
                        )

                        @Html.HiddenFor(m => m.Token)

                        <div class="input-group mb-1">

                            @Html.PasswordFor(
                                m => m.NuevaContrasena,
                                new
                                {
                                    @class = "form-control",
                                    placeholder = "Nueva contraseña",
                                    autocomplete = "new-password"
                                }
                            )

                            <div class="input-group-text">
                                <span class="bi bi-lock-fill"></span>
                            </div>

                        </div>

                        @Html.ValidationMessageFor(
                            m => m.NuevaContrasena,
                            "",
                            new
                            {
                                @class = "text-danger small d-block mb-3"
                            }
                        )

                        <div class="input-group mb-1">

                            @Html.PasswordFor(
                                m => m.ConfirmarContrasena,
                                new
                                {
                                    @class = "form-control",
                                    placeholder = "Confirmar nueva contraseña",
                                    autocomplete = "new-password"
                                }
                            )

                            <div class="input-group-text">
                                <span class="bi bi-lock"></span>
                            </div>

                        </div>

                        @Html.ValidationMessageFor(
                            m => m.ConfirmarContrasena,
                            "",
                            new
                            {
                                @class = "text-danger small d-block mb-3"
                            }
                        )

                        <div class="d-grid gap-2 mt-3">

                            <button type="submit"
                                    class="btn btn-primary">
                                Restablecer contraseña
                            </button>

                        </div>
                    }
                }

                <hr />

                <p class="mb-0">

                    <a href="@Url.Action("Index", "Login")">

                        <i class="bi bi-arrow-left"></i>
                        Volver al inicio de sesión

                    </a>

                </p>

            </div>

        </div>

    </main>

</body>
</html>