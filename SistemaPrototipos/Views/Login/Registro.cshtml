@model SistemaPrototipos.Models.RegistroModel
@{
    ViewData["Title"] = "Registro de usuario";
    ViewData["BodyClass"] = "register-page";
    Layout = "_LayoutLogin";
}

<main class="register-box">
    <h1 class="register-logo">
        <a asp-controller="Login" asp-action="Index"><b>Sistema</b>Prototipos</a>
    </h1>
    <div class="card card-outline card-primary">
        <div class="card-body register-card-body">
            <p class="register-box-msg">Registrar una cuenta nueva</p>

            <form asp-controller="Login" asp-action="Registro" method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

                <label class="visually-hidden" asp-for="Nombre">Nombre completo</label>
                <div class="input-group">
                    <input asp-for="Nombre" class="form-control" placeholder="Nombre completo" autocomplete="name" />
                    <div class="input-group-text">
                        <span class="bi bi-person"></span>
                    </div>
                </div>
                <span asp-validation-for="Nombre" class="text-danger small d-block mb-3"></span>

                <label class="visually-hidden" asp-for="Correo">Correo electrónico</label>
                <div class="input-group">
                    <input asp-for="Correo" type="email" class="form-control" placeholder="Correo electrónico" autocomplete="email" />
                    <div class="input-group-text">
                        <span class="bi bi-envelope"></span>
                    </div>
                </div>
                <span asp-validation-for="Correo" class="text-danger small d-block mb-3"></span>

                <label class="visually-hidden" asp-for="Contrasena">Contraseña</label>
                <div class="input-group">
                    <input asp-for="Contrasena" class="form-control" placeholder="Contraseña (mínimo 6 caracteres)" autocomplete="new-password" />
                    <div class="input-group-text">
                        <span class="bi bi-lock-fill"></span>
                    </div>
                </div>
                <span asp-validation-for="Contrasena" class="text-danger small d-block mb-3"></span>

                <label class="visually-hidden" asp-for="ConfirmarContrasena">Confirmar contraseña</label>
                <div class="input-group">
                    <input asp-for="ConfirmarContrasena" class="form-control" placeholder="Confirmar contraseña" autocomplete="new-password" />
                    <div class="input-group-text">
                        <span class="bi bi-lock"></span>
                    </div>
                </div>
                <span asp-validation-for="ConfirmarContrasena" class="text-danger small d-block mb-3"></span>

                <div class="row">
                    <div class="col-7">
                        <div class="form-check">
                            <input asp-for="AceptaTerminos" class="form-check-input" />
                            <label asp-for="AceptaTerminos" class="form-check-label">
                                Acepto los <a href="#">términos</a>
                            </label>
                        </div>
                        <span asp-validation-for="AceptaTerminos" class="text-danger small d-block"></span>
                    </div>
                    <div class="col-5">
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary">Registrarme</button>
                        </div>
                    </div>
                </div>
            </form>

            <hr />

            <p class="mb-0">
                <a asp-controller="Login" asp-action="Index" class="text-center">Ya tengo una cuenta</a>
            </p>
        </div>
    </div>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
