@model Tarea1.Models.RecuperarContrasenaModel

@{
    Layout = null;
}

<!doctype html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Recuperar contraseña | Bioquimia</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <link rel="stylesheet" href="~/assets/css/adminlte.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" />
</head>

<body class="login-page bg-body-secondary">

    <main class="login-box">

        <div class="login-logo">
            <img src="~/assets/img/logoBioquimiaAlt.png"
                 alt="Logo Bioquimia"
                 style="max-width: 320px; height: auto;" />

            <p class="mt-2 mb-0 text-secondary">
                Sistema de prototipos
            </p>
        </div>

        <div class="card card-outline card-primary">

            <div class="card-body login-card-body">

                <p class="login-box-msg">
                    Recuperar acceso a su cuenta
                </p>

                <p class="text-muted small">
                    Ingrese el correo electrónico que utilizó
                    al registrar su cuenta.
                </p>

                @if (ViewBag.Mensaje != null)
                {
                    <div class="alert alert-success">
                        @ViewBag.Mensaje
                    </div>
                }

                @using (Html.BeginForm(
                    "RecuperarContrasena",
                    "Login",
                    FormMethod.Post))
                {
                    @Html.AntiForgeryToken()

                    @Html.ValidationSummary(
                        true,
                        "",
                        new { @class = "text-danger small mb-2" }
                    )

                    <div class="input-group mb-1">

                        @Html.TextBoxFor(
                            m => m.Correo,
                            new
                            {
                                @class = "form-control",
                                type = "email",
                                placeholder = "Correo electrónico",
                                autocomplete = "email"
                            }
                        )

                        <div class="input-group-text">
                            <span class="bi bi-envelope"></span>
                        </div>

                    </div>

                    @Html.ValidationMessageFor(
                        m => m.Correo,
                        "",
                        new { @class = "text-danger small d-block mb-3" }
                    )

                    <div class="d-grid gap-2 mt-3">

                        <button type="submit"
                                class="btn btn-primary">
                            Generar enlace de recuperación
                        </button>

                    </div>
                }

                @if (ViewBag.EnlaceRecuperacion != null)
                {
                    <hr />

                    <div class="alert alert-warning">

                        <h6>
                            <i class="bi bi-info-circle"></i>
                            Modo demostración
                        </h6>

                        <p class="small mb-2">
                            Este enlace se muestra únicamente
                            para realizar las pruebas locales.
                            No se ha enviado ningún correo.
                        </p>

                        <a href="@ViewBag.EnlaceRecuperacion"
                           class="btn btn-success btn-sm w-100">
                            Abrir enlace de recuperación
                        </a>

                        <div class="mt-3">

                            <label class="form-label small">
                                Enlace generado:
                            </label>

                            <input type="text"
                                   class="form-control form-control-sm"
                                   value="@ViewBag.EnlaceRecuperacion"
                                   readonly />

                        </div>

                    </div>
                }

                <hr />

                <p class="mb-0">

                    <a href="@Url.Action("Index", "Login")">
                        <i class="bi bi-arrow-left"></i>
                        Volver al inicio de sesión
                    </a>

                </p>

            </div>

        </div>

    </main>

</body>
</html>