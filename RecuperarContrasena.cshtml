
@model SistemaPrototipos.Models.RecuperarContrasenaModel

@{
    ViewData["Title"] = "Recuperar contraseña";
    ViewData["BodyClass"] = "login-page";
    Layout = "_LayoutLogin";
}

<main class="login-box">
    <h1 class="login-logo">
        <a asp-controller="Login" asp-action="Index">
            <b>Sistema</b>Prototipos
        </a>
    </h1>

    <div class="card card-outline card-primary">
        <div class="card-body login-card-body">

            <p class="login-box-msg">
                Recuperar acceso a su cuenta
            </p>

            <p class="text-muted small">
                Ingrese el correo electrónico que utilizó
                al registrar su cuenta.
            </p>

            @if (ViewBag.Mensaje != null)
            {
                <div class="alert alert-success">
                    @ViewBag.Mensaje
                </div>
            }

            <form asp-controller="Login"
                  asp-action="RecuperarContrasena"
                  method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger small mb-2">
                </div>

                <label class="visually-hidden" asp-for="Correo">
                    Correo electrónico
                </label>

                <div class="input-group">
                    <input asp-for="Correo"
                           type="email"
                           class="form-control"
                           placeholder="Correo electrónico"
                           autocomplete="email" />

                    <div class="input-group-text">
                        <span class="bi bi-envelope"></span>
                    </div>
                </div>

                <span asp-validation-for="Correo"
                      class="text-danger small d-block mb-3">
                </span>

                <div class="d-grid gap-2 mt-3">
                    <button type="submit"
                            class="btn btn-primary">
                        Generar enlace de recuperación
                    </button>
                </div>
            </form>

            @if (ViewBag.EnlaceRecuperacion != null)
            {
                <hr />

                <div class="alert alert-warning">
                    <h6>
                        <i class="bi bi-info-circle"></i>
                        Modo demostración
                    </h6>

                    <p class="small mb-2">
                        Este enlace se muestra únicamente
                        para realizar las pruebas locales.
                        No se ha enviado ningún correo.
                    </p>

                    <a href="@ViewBag.EnlaceRecuperacion"
                       class="btn btn-success btn-sm w-100">
                        Abrir enlace de recuperación
                    </a>

                    <div class="mt-3">
                        <label class="form-label small">
                            Enlace generado:
                        </label>

                        <input type="text"
                               class="form-control form-control-sm"
                               value="@ViewBag.EnlaceRecuperacion"
                               readonly />
                    </div>
                </div>
            }

            <hr />

            <p class="mb-0">
                <a asp-controller="Login"
                   asp-action="Index">
                    <i class="bi bi-arrow-left"></i>
                    Volver al inicio de sesión
                </a>
            </p>

        </div>
    </div>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}