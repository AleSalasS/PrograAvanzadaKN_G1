
@model SistemaPrototipos.Models.RestablecerContrasenaModel

@{
    ViewData["Title"] = "Restablecer contraseña";
    ViewData["BodyClass"] = "login-page";
    Layout = "_LayoutLogin";
}

<main class="login-box">
    <h1 class="login-logo">
        <a asp-controller="Login" asp-action="Index">
            <b>Sistema</b>Prototipos
        </a>
    </h1>

    <div class="card card-outline card-primary">
        <div class="card-body login-card-body">

            <p class="login-box-msg">
                Establecer nueva contraseña
            </p>

            @if (ViewBag.TokenInvalido == true)
            {
                <div class="alert alert-danger">
                    <h6>
                        <i class="bi bi-exclamation-triangle"></i>
                        Enlace inválido o vencido
                    </h6>

                    <p class="small mb-2">
                        El enlace de recuperación no es válido,
                        ya venció o ya fue utilizado.
                    </p>

                    <a asp-controller="Login"
                       asp-action="RecuperarContrasena"
                       class="btn btn-primary btn-sm">
                        Solicitar un nuevo enlace
                    </a>
                </div>
            }
            else
            {
                <p class="text-muted small">
                    Ingrese su nueva contraseña y confírmela
                    para recuperar el acceso a su cuenta.
                </p>

                <form asp-controller="Login"
                      asp-action="RestablecerContrasena"
                      method="post">

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger small mb-2">
                    </div>

                    <input asp-for="Token" type="hidden" />

                    <label class="visually-hidden"
                           asp-for="NuevaContrasena">
                        Nueva contraseña
                    </label>

                    <div class="input-group">
                        <input asp-for="NuevaContrasena"
                               class="form-control"
                               placeholder="Nueva contraseña"
                               autocomplete="new-password" />

                        <div class="input-group-text">
                            <span class="bi bi-lock-fill"></span>
                        </div>
                    </div>

                    <span asp-validation-for="NuevaContrasena"
                          class="text-danger small d-block mb-3">
                    </span>

                    <label class="visually-hidden"
                           asp-for="ConfirmarContrasena">
                        Confirmar contraseña
                    </label>

                    <div class="input-group">
                        <input asp-for="ConfirmarContrasena"
                               class="form-control"
                               placeholder="Confirmar nueva contraseña"
                               autocomplete="new-password" />

                        <div class="input-group-text">
                            <span class="bi bi-lock"></span>
                        </div>
                    </div>

                    <span asp-validation-for="ConfirmarContrasena"
                          class="text-danger small d-block mb-3">
                    </span>

                    <div class="d-grid gap-2 mt-3">
                        <button type="submit"
                                class="btn btn-primary">
                            Restablecer contraseña
                        </button>
                    </div>
                </form>
            }

            <hr />

            <p class="mb-0">
                <a asp-controller="Login"
                   asp-action="Index">
                    <i class="bi bi-arrow-left"></i>
                    Volver al inicio de sesión
                </a>
            </p>

        </div>
    </div>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}